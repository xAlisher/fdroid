{"repo": {"timestamp": 1786646242000, "version": 20002, "name": "Alisher's apps", "icon": "icon.png", "address": "https://xalisher.github.io/fdroid/repo", "description": "Private, self-hosted Android apps on Logos \u2014 no Google, no accounts, no central server. Peers: a peer-to-peer messenger over Logos, MeshCore (LoRa) and Bluetooth mesh, end-to-end and at-rest encrypted. Booth & Receiver: broadcast and tune in to decentralised anonymous radio over Tor + Logos Messaging."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "xAlisher", "categories": ["Internet", "Multimedia"], "suggestedVersionCode": "1", "description": "Broadcast a decentralised, anonymous radio station from your phone: create a\nstation, speak into the mic, and listeners tune in over Tor + Logos Messaging.\n\nThree-phase flow (Setup \u2192 Staging \u2192 Live) with a live-status dashboard, a\nreal-time mic waveform, mute, and identity tiers: Anon, on-device key, or a\nhardware Keycard over NFC. The broadcasting mirror of Receiver.", "issueTracker": "https://github.com/xAlisher/booth-android/issues", "license": "MIT", "name": "Booth", "sourceCode": "https://github.com/xAlisher/booth-android", "summary": "Broadcast a decentralised anonymous radio station", "added": 1783356066000, "packageName": "com.boothandroid", "lastUpdated": 1783356066000}, {"authorName": "xAlisher", "categories": ["Internet", "System"], "suggestedVersionCode": "1", "description": "Watch, control and receive notifications from a Logos blockchain node running\nin Basecamp on your desktop \u2014 from your phone, over a Tor v3 onion service\nwith client authorization.\n\nPair by scanning a QR code shown on the desktop. From then on the phone can\nsee the node's height, peers, sync state, blend status, balance and errors,\nand can start or stop it. No account, no server in the middle, no port\nforwarding.\n\nTor is embedded in the app \u2014 Orbot is not required, and there are no Google\nPlay Services. There is no analytics, no telemetry and no network destination\nother than your own node.\n\nIt does NOT hide from your internet provider that you use Tor, on either end.\nSee the privacy documentation for what the onion service does and does not\nprotect.\n\nNOT AN OFFICIAL LOGOS PRODUCT. Independent project, not endorsed by or\naffiliated with Logos or IFT.", "issueTracker": "https://github.com/xAlisher/node-remote/issues", "license": "MIT", "name": "Node Remote", "sourceCode": "https://github.com/xAlisher/node-remote", "summary": "Watch and control your Logos node over Tor", "added": 1786646240000, "packageName": "co.logos.noderemote", "lastUpdated": 1786646240000}, {"authorName": "xAlisher", "categories": ["Internet"], "suggestedVersionCode": "128", "description": "A private, peer-to-peer messenger. Your identity lives on this device \u2014 no phone\nnumber, no account, no central server, no Google.\n\nReach people over three transports: Logos (a pure-Rust delivery node), MeshCore\n(LoRa radio), or Bluetooth mesh \u2014 one shared timeline, colour-coded by transport.\n1:1 and group chats are end-to-end encrypted with MLS; send voice notes, images,\ncamera photos, and location. Works offline over Bluetooth/LoRa when the network\nis down.\n\nYour messages, encryption keys, and identity are encrypted at rest (Android\nKeystore + SQLCipher). Optional PIN lock with an auto-lock and duress-wipe.", "issueTracker": "https://github.com/xAlisher/peers/issues", "license": "MIT", "name": "Peers", "sourceCode": "https://github.com/xAlisher/peers", "summary": "Private peer-to-peer messenger over Logos, MeshCore & Bluetooth", "webSite": "https://peers.tech", "added": 1785939055000, "packageName": "com.logoschat", "lastUpdated": 1786642000000}, {"authorName": "xAlisher", "categories": ["Internet", "Multimedia"], "suggestedVersionCode": "2", "description": "Discover and listen to decentralised, anonymous radio stations over\nTor + Logos Messaging. Stations are found over a peer-to-peer directory and\nstreamed over Tor onion services \u2014 no central server. The listening mirror\nof Booth.", "issueTracker": "https://github.com/xAlisher/receiver-android/issues", "license": "MIT", "name": "Receiver", "sourceCode": "https://github.com/xAlisher/receiver-android", "summary": "Discover & listen to decentralised radio", "added": 1783356066000, "packageName": "com.receiverandroid", "lastUpdated": 1783356066000}], "packages": {"co.logos.noderemote": [{"added": 1786646240000, "apkName": "node-remote-0.1.0-arm64.apk", "hash": "8f7d24c4f9a9adf57d4f9ad1dbb4b0cbe9e81f869c6fa656357c127c48da2f8e", "hashType": "sha256", "minSdkVersion": 26, "nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "packageName": "co.logos.noderemote", "sig": "eeefeb6362f10caa176230d9caa7fe00", "signer": "6d80db3476bcada78fefa3a16b2309fd1cf830e5fc836f3e9c6c48678051ae74", "size": 28151039, "targetSdkVersion": 36, "uses-permission": [["android.permission.INTERNET", null], ["android.permission.ACCESS_NETWORK_STATE", null], ["android.permission.POST_NOTIFICATIONS", null], ["android.permission.CAMERA", null], ["android.permission.FOREGROUND_SERVICE", null], ["android.permission.FOREGROUND_SERVICE_DATA_SYNC", null], ["co.logos.noderemote.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION", null]], "versionCode": 1, "versionName": "0.1.0"}], "com.boothandroid": [{"added": 1783356066000, "apkName": "booth-android-0.1.0-arm64.apk", "hash": "4d8079dc3ddc2f380d3153453472dfc4b04cdef4c20ff2ee083676c666a49492", "hashType": "sha256", "minSdkVersion": 24, "nativecode": ["arm64-v8a"], "packageName": "com.boothandroid", "sig": "b6e0344e9cbcbcd6f20dc82b513925f6", "signer": "fac61745dc0903786fb9ede62a962b399f7348f0bb6f899b8332667591033b9c", "size": 49766209, "targetSdkVersion": 36, "uses-permission": [["android.permission.INTERNET", null], ["android.permission.RECORD_AUDIO", null], ["android.permission.FOREGROUND_SERVICE", null], ["android.permission.FOREGROUND_SERVICE_MICROPHONE", null], ["android.permissi