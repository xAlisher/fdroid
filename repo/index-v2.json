{"repo": {"name": {"en-US": "Alisher's apps"}, "description": {"en-US": "Private, self-hosted Android apps on Logos — no Google, no accounts, no central server. Peers: a peer-to-peer messenger over Logos, MeshCore (LoRa) and Bluetooth mesh, end-to-end and at-rest encrypted. Booth & Receiver: broadcast and tune in to decentralised anonymous radio over Tor + Logos Messaging."}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "0f3303e546cf948f7bdddd1d25460c00e2100a6555ac725fca1f19df866b185e", "size": 730}}, "address": "https://xalisher.github.io/fdroid/repo", "timestamp": 1786049904000, "categories": {"Internet": {"name": {"en-US": "Internet"}}, "Multimedia": {"name": {"en-US": "Multimedia"}}}}, "packages": {"com.boothandroid": {"metadata": {"added": 1783356066000, "categories": ["Internet", "Multimedia"], "issueTracker": "https://github.com/xAlisher/booth-android/issues", "lastUpdated": 1783356066000, "license": "MIT", "sourceCode": "https://github.com/xAlisher/booth-android", "authorName": "xAlisher", "name": {"en-US": "Booth"}, "summary": {"en-US": "Broadcast a decentralised anonymous radio station"}, "description": {"en-US": "Broadcast a decentralised, anonymous radio station from your phone: create a\nstation, speak into the mic, and listeners tune in over Tor + Logos Messaging.\n\nThree-phase flow (Setup → Staging → Live) with a live-status dashboard, a\nreal-time mic waveform, mute, and identity tiers: Anon, on-device key, or a\nhardware Keycard over NFC. The broadcasting mirror of Receiver."}, "preferredSigner": "fac61745dc0903786fb9ede62a962b399f7348f0bb6f899b8332667591033b9c"}, "versions": {"4d8079dc3ddc2f380d3153453472dfc4b04cdef4c20ff2ee083676c666a49492": {"added": 1783356066000, "file": {"name": "/booth-android-0.1.0-arm64.apk", "sha256": "4d8079dc3ddc2f380d3153453472dfc4b04cdef4c20ff2ee083676c666a49492", "size": 49766209}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.1.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 24, "targetSd