{"repo": {"timestamp": 1786646242000, "categories": {"System": {"name": {"en-US": "System"}}}}, "packages": {"co.logos.noderemote": {"metadata": {"added": 1786646240000, "categories": ["Internet", "System"], "issueTracker": "https://github.com/xAlisher/node-remote/issues", "lastUpdated": 1786646240000, "license": "MIT", "sourceCode": "https://github.com/xAlisher/node-remote", "authorName": "xAlisher", "name": {"en-US": "Node Remote"}, "summary": {"en-US": "Watch and control your Logos node over Tor"}, "description": {"en-US": "Watch, control and receive notifications from a Logos blockchain node running\nin Basecamp on your desktop — from your phone, over a Tor v3 onion service\nwith client authorization.\n\nPair by scanning a QR code shown on the desktop. From then on the phone can\nsee the node's height, peers, sync state, blend status, balance and errors,\nand can start or stop it. No account, no server in the middle, no port\nforwarding.\n\nTor is embedded in the app — Orbot is not required, and there are no Google\nPlay Services. There is no analytics, no telemetry and no network destination\nother than your own node.\n\nIt does NOT hide from your internet provider that you use Tor, on either end.\nSee the privacy documentation for what the onion service does and does not\nprotect.\n\nNOT AN OFFICIAL LOGOS PRODUCT. Independent project, not endorsed by or\naffiliated with Logos or IFT."}, "preferredSigner": "6d80db3476bcada78fefa3a16b2309fd1cf830e5fc836f3e9c6c48678051ae74"}, "versions": {"8f7d24c4f9a9adf57d4f9ad1dbb4b0cbe9e81f869c6fa656357c127c48da2f8e": {"added": 1786646240000, "file": {"name": "/node-remote-0.1.0-arm64.apk", "sha256": "8f7d24c4f9a9adf57d4f9ad1dbb4b0cbe9e81f869c6fa656357c127c48da2f8e", "size": 28151039}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.1.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["6d80db3476bcada78fefa3a16b2309fd1cf830e5fc836f3