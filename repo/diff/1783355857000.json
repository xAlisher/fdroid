{"repo": {"name": {"en-US": "Alisher's apps"}, "description": {"en-US": "Private, self-hosted Android apps on Logos — no Google, no accounts, no central server. Peers: a peer-to-peer messenger over Logos, MeshCore (LoRa) and Bluetooth mesh, end-to-end and at-rest encrypted. Booth & Receiver: broadcast and tune in to decentralised anonymous radio over Tor + Logos Messaging."}, "timestamp": 1785316680000, "categories": {"fdroid": null, "Internet": {"name": {"en-US": "Internet"}}, "Multimedia": {"name": {"en-US": "Multimedia"}}}}, "packages": {"com.boothandroid": {"metadata": {"added": 1783356066000, "categories": ["Internet", "Multimedia"], "issueTracker": "https://github.com/xAlisher/booth-android/issues", "lastUpdated": 1783356066000, "license": "MIT", "sourceCode": "https://github.com/xAlisher/booth-android", "authorName": "xAlisher", "summary": {"en-US": "Broadcast a decentralised anonymous radio station"}, "description": {"en-US": "Broadcast a decentralised, anonymous radio station from your phone: create a\nstation, speak into the mic, and listeners tune in over Tor + Logos Messaging.\n\nThree-phase flow (Setup → Staging → Live) with a live-status dashboard, a\nreal-time mic waveform, mute, and identity tiers: Anon, on-device key, or a\nhardware Keycard over NFC. The broadcasting mirror of Receiver."}}, "versions": {"390014cd7f1d9e1a2fbf8871104878b88e63f9d5874038fcb562162a293c2b49": null, "4d8079dc3ddc2f380d3153453472dfc4b04cdef4c20ff2ee083676c666a49492": {"added": 1783356066000, "file": {"name": "/booth-android-0.1.0-arm64.apk", "sha256": "4d8079dc3ddc2f380d3153453472dfc4b04cdef4c20ff2ee083676c666a49492", "size": 49766209}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.1.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 36}, "signer": {"sha256": ["fac61745dc0903786fb9ede62a962b399f7348f0bb6f899b8332667591033b9c"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_MICROPHONE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.NFC"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "com.boothandroid.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.logoschat": {"metadata": {"added": 1785280344000, "categories": ["Internet"], "issueTracker": "https://github.com/xAlisher/peers/issues", "lastUpdated": 1785280344000, "license": "MIT", "sourceCode": "https://github.com/xAlisher/peers", "webSite": "https://peers.tech", "authorName": "xAlisher", "name": {"en-US": "Peers"}, "summary": {"en-US": "Private peer-to-peer messenger over Logos, MeshCore & Bluetooth"}, "description": {"en-US": "A private, peer-to-peer messenger. Your identity lives on this device — no phone\nnumber, no account, no central server, no Google.\n\nReach people over three transports: Logos (a pure-Rust delivery node), MeshCore\n(LoRa radio), or Bluetooth mesh — one shared timeline, colour-coded by transport.\n1:1 and group chats are end-to-end encrypted with MLS; send voice notes, images,\ncamera photos, and location. Works offline over Bluetooth/LoRa when the network\nis down.\n\nYour messages, encryption keys, and identity are encrypted at rest (Android\nKeystore + SQLCipher). Optional PIN lock with an auto-lock and duress-wipe."}, "preferredSigner": "fac61745dc0903786fb9ede62a962b399f7348f0bb6f899b8332667591033b9c"}, "versions": {"20d211c5f26ec046d7f2069d3490cc6f429ea0851dcf7542d6c026475a057c77": {"added": 1785280344000, "file": {"name": "/peers-0.7.61-arm64.apk", "sha256": "20d211c5f26ec046d7f2069d3490cc6f429ea0851dcf7542d6c026475a057c77", "size": 69515575}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.7.61", "versionCode": 73, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 34}, "signer": {"sha256": ["fac617